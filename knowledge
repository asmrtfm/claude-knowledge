#!/usr/bin/env bash

shopt -s extglob

if [[ "${1,,}" == *(\-)no?(\-|_)pager ]]; then
  shift
  PRESENTER=cat
else
  [[ "$PAGER" != ?(\")'false'?(\") ]] || PRESENTER=cat
fi

if [[ "$IMAROBOT" == ?(\")'true'?(\") ]]; then
  PRESENTER=cat
  JQARGS='-M'
fi

[[ -n "$PRESENTER" ]] || PRESENTER=${MANPAGER:-${PAGER:-cat}}


# CLI for the claude-knowledge system.
# Usage: knowledge <command> [args...]
_usage() { $PRESENTER <<'INFO'
COMMAND
        knowledge — CLI for the claude-knowledge system

SYNOPSIS
        knowledge <SUBCOMMAND|OPTION> [TERTIARY_COMMAND|ARGUMENTS|OPTION] [ARGUMENTS|OPTION]

DESCRIPTION
        Manages knowledge hooks, INDEX.md file-to-entry mappings, and
        installation for the claude-knowledge system.

OPTIONS
    --help, -h, help    Show this help text.

COMMANDS
    init [args...]               Install the knowledge system into a target project.
    --reinstall-hooks [args...]  Reinstall hooks only.
    --verify-settings [dir]        Check settings files against .envrc (default: pwd).

    hooks                        Toggle which knowledge hooks are disabled via fzpick.

    link <source> <entry>        Add <entry> to <source>'s bracket list.
                                 Creates the source line if new. No-op if duplicate.

    unlink <source> <entry>      Remove <entry> from <source>'s bracket list.
                                 Deletes the line if it was the last entry.

    show <path>                  Look up a source or entry; prints the other side.

    purge <entry>                Remove <entry> from ALL source mappings.

    rekey <old> <new>            Rename a source path, preserving entries.
                                 Merges if <new> already exists.

    sort                         Sort all index data lines alphabetically by source path.

    index list [-f json|yaml]    Print the index. Raw lines by default.

    entries list [pattern] [-f]  List entry files with frontmatter metadata.

INDEX.MD FORMAT
        INDEX.md maps source files (paths relative to repo root) to the knowledge
        entries that reference them (paths relative to entries/).

           Entry:  <CATEGORY>/<TOPIC>.md

          Format:  <source_file> -> [<entry1>, <entry2>, ...]

         Examples:
                  app/models/category.rb -> [domain/niche-scopes.md, relationships/phenotypes.md]
                  package.json -> [architecture/dependencies.md, gotchas/version-pinning.md]

INFO

  exit ${1:-0}
}
[[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || _usage


# Only needed for `init`
# otherwise, we always operate under the assumption that either the user is running this command from their PROJECT_ROOT
# or the model is calling it indirectly via one of our scripts or in maintenance mode - in both cases, any necessary ENV variables should already be set.
SELF="$(realpath "${BASH_SOURCE[0]}")"
SOURCE_DIR="${SELF%\/*}"

# Resolve INDEX.md from the project's .claude/knowledge/ directory
INDEX=".claude/knowledge/INDEX.md"

# ─── Shared helpers ────────────────────────────────────────────────

die() { echo "[ERROR] (knowledge): $*" >&2; exit 1; }

# Extract individual entry paths from the bracket notation "[a, b, c]"
_parse_entries() {
  local bracket_content="$1"
  echo "$bracket_content" | tr -d '[]' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$'
}

