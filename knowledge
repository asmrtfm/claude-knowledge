# Reassemble newline-separated entry paths back into "[a, b, c]" notation
_format_entries() {
  local entries="$1"
  echo "[$(echo "$entries" | paste -sd ',' - | sed 's/,/, /g')]"
}


# Guard: index commands require INDEX.md to exist
_require_index() { [[ -f "$INDEX" ]] || die "INDEX.md not found at $INDEX"; }


# ── init ──
cmd_init() { exec "$SOURCE_DIR/init.sh" "${@}"; }


# ── hooks: toggle which hooks are disabled via fzpick ──
cmd_hooks() {
  local hooks_dir=".claude/hooks/knowledge"
  local disabled_file=".claude/hooks/.disabled-hooks"

  [[ -d "$hooks_dir" ]] || { echo "No hooks directory at $hooks_dir"; exit 1; }

  # Collect hook basenames, build display items
  local -a hooks=() items=()
  for f in "$hooks_dir"/*.sh; do
    [[ -f "$f" ]] || continue
    local bn="$(basename "$f")"
    hooks+=("$bn")
    items+=("knowledge/$bn")
  done
  [[ ${#items[@]} -gt 0 ]] || { echo "No hook scripts found in $hooks_dir"; exit 1; }

  # Read current disabled state
  local -a disabled=()
  local all_disabled=false
  if [[ -f "$disabled_file" ]]; then
    while IFS= read -r line; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      if [[ "$line" == "knowledge" ]]; then
        all_disabled=true
        break
      fi
      disabled+=("$line")
    done < "$disabled_file"
  fi

  # Build comma-separated pre-selected list for fzpick
  local preselected=""
  for h in "${hooks[@]}"; do
    if [[ "$all_disabled" == true ]] || printf '%s\n' "${disabled[@]+"${disabled[@]}"}" | grep -qxF "$h"; then
      preselected="${preselected:+$preselected,}knowledge/$h"
    fi
  done

  # Run fzpick — selected items are the disabled hooks
  local fzpick_args=(
    --on="X" --off=" "
    --header="Toggle hooks to disable  [X] = disabled"
  )
  [[ -z "$preselected" ]] || fzpick_args+=(--selected="$preselected")
  fzpick_args+=("${items[@]}")

  local output
  output=$(fzpick "${fzpick_args[@]}") || true

  # Write results to .disabled-hooks
  if [[ -z "$output" ]]; then
    rm -f "$disabled_file"
    echo "All hooks enabled."
    return
  fi

  local selected_count
  selected_count=$(echo "$output" | wc -l)

  mkdir -p "$(dirname "$disabled_file")"
  if [[ "$selected_count" -eq "${#hooks[@]}" ]]; then
    echo "knowledge" > "$disabled_file"
    echo "All knowledge hooks disabled."
  else
    # Strip "knowledge/" prefix to store basenames
    echo "$output" | sed 's|^knowledge/||' > "$disabled_file"
    echo "Disabled hooks updated:"
    sed 's/^/  /' "$disabled_file"
  fi
}

# ── link: add entry to source mapping ─────────────────────────────
# Adds <entry> to the mapping for <source_file>.
# If the source already has a line, appends to its bracket list (no-op if duplicate).
# If new, creates the line and re-sorts.
cmd_link() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        link

SYNOPSIS
        knowledge link <source> <entry>

DESCRIPTION
        Add <entry> to <source>'s bracket list in INDEX.md.
        Creates the source line if it doesn't exist. No-op if the mapping already exists.

ARGUMENT
        <source>    Source file path (relative to repo root)
        <entry>     Knowledge entry path (relative to entries/)

EXAMPLES
        knowledge link app/models/order.rb domain/order-lifecycle.md
        knowledge link package.json gotchas/version-pinning.md

INFO
    return 0; }
  (($# == 2)) || die "usage: $0 link <source> <entry>"

  _require_index
  local src="$1" entry="$2"

  if grep -q "^${src} -> " "$INDEX"; then
    local existing
    existing="$(grep "^${src} -> " "$INDEX" | sed "s/^${src//\//\\/} -> //")"

    if echo "$existing" | tr -d '[]' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -qxF "$entry"; then
      echo "already mapped: $src -> $entry"
      return 0
    fi

    local entries
    entries="$(_parse_entries "$existing")"
    entries="$(printf '%s\n%s' "$entries" "$entry")"

    local formatted
    formatted="$(_format_entries "$entries")"
    local src_esc="${src//\//\\/}"
    local formatted_esc="${formatted//\//\\/}"
    sed -i "s/^${src_esc} -> .*$/${src_esc} -> ${formatted_esc}/" "$INDEX"
  else
    echo "$src -> [$entry]" >> "$INDEX"
    cmd_sort
  fi
  echo "added: $src -> $entry"
}


# ── unlink: remove entry from source mapping ──────────────────────
# Removes <entry> from <source_file>'s bracket list.
# Deletes the entire line if it was the last entry.
cmd_unlink() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        unlink

SYNOPSIS
        knowledge unlink <source> <entry>

DESCRIPTION
        Remove <entry> from <source>'s bracket list in INDEX.md.
        Deletes the source line entirely if it was the last entry.

ARGUMENTS
        <source>    Source file path (relative to repo root)
        <entry>     Knowledge entry path (relative to entries/)

EXAMPLE
        knowledge unlink app/models/order.rb domain/order-lifecycle.md

INFO
    return 0; }
  (($# == 2)) || die "usage: $0 unlink <source> <entry>"

  _require_index
  local src="$1" entry="$2"

  if ! grep -q "^${src} -> " "$INDEX"; then
    echo "no mapping for: $src"
    return 0
  fi

  local existing
  existing="$(grep "^${src} -> " "$INDEX" | sed "s/^${src//\//\\/} -> //")"
  local entries
  entries="$(_parse_entries "$existing" | grep -vxF "$entry")" || true

  local src_esc="${src//\//\\/}"
  if [ -z "$entries" ]; then
    sed -i "/^${src_esc} -> /d" "$INDEX"
    echo "removed line: $src"
  else
    local formatted
    formatted="$(_format_entries "$entries")"
    local formatted_esc="${formatted//\//\\/}"
    sed -i "s/^${src_esc} -> .*$/${src_esc} -> ${formatted_esc}/" "$INDEX"
    echo "removed: $src -> $entry"
  fi
}

# ── purge: remove entry from all source mappings ──────────────────
# Removes <entry> from every source file mapping that references it.
cmd_purge() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        purge

SYNOPSIS
        knowledge purge <entry>

DESCRIPTION
        Remove <entry> from ALL source file mappings in INDEX.md.
        Use when archiving or deleting a knowledge entry.

ARGUMENTS
        <entry>     Knowledge entry path (relative to entries/)

EXAMPLE
        knowledge purge gotchas/stale-cache.md

INFO
    return 0; }
  (($# == 1)) || die "usage: $0 purge <entry>"

  _require_index
  local entry="$1"
  local count=0

  while IFS= read -r src; do
    cmd_unlink "$src" "$entry"
    ((count++))
  done < <(grep -F "$entry" "$INDEX" | cut -d' ' -f1)

  echo "purged $entry from $count source(s)"
}

# ── rekey: rename source path in index ─────────────────────────────
# Renames a source file path in the index, keeping its entry list intact.
# If <new_source> already exists, merges the entry lists (no duplicates).
cmd_rekey() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        rekey

SYNOPSIS
        knowledge rekey <old> <new>

DESCRIPTION
        Rename a source file path in INDEX.md, preserving its entry list.
        If <new> already exists, merges the entry lists (no duplicates). Re-sorts after.

ARGUMENTS
        <old>    Current source file path
        <new>    New source file path

EXAMPLE
        knowledge rekey app/models/transaction.rb app/models/purchase.rb

INFO
    return 0; }
  (($# == 2)) || die "usage: $0 rekey <old> <new>"

  _require_index
  local old_src="$1" new_src="$2"

  if ! grep -q "^${old_src} -> " "$INDEX"; then
    die "no mapping for: $old_src"
  fi

  local old_entries_raw
  old_entries_raw="$(grep "^${old_src} -> " "$INDEX" | sed "s/^${old_src//\//\\/} -> //")"
  local old_entries
  old_entries="$(_parse_entries "$old_entries_raw")"

  local old_esc="${old_src//\//\\/}"
  sed -i "/^${old_esc} -> /d" "$INDEX"

  if grep -q "^${new_src} -> " "$INDEX"; then
    while IFS= read -r entry; do
      cmd_link "$new_src" "$entry"
    done <<< "$old_entries"
  else
    local formatted
    formatted="$(_format_entries "$old_entries")"
    echo "$new_src -> $formatted" >> "$INDEX"
    cmd_sort
  fi
  echo "renamed: $old_src -> $new_src"
}



# ── Entries: list — list entry files with frontmatter metadata ─────
# Walks entries/ under .claude/knowledge/, extracts frontmatter via yq,
# outputs a |‑delimited table sorted newest-first by `updated`.
# Optional positional <pattern> filters entries by case-insensitive substring match.
cmd_entries_list() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
TERTIARY_COMMAND
    entries list

SYNOPSIS
    knowledge entries list [<pattern>] [-f|--fields|--format <fields,...>]

DESCRIPTION
    List knowledge entry files with selected frontmatter fields.
    Results are sorted newest to oldest by the 'updated' field.
    An optional <pattern> filters entries by case-insensitive substring match
    against entry paths.

ARGUMENTS
    <pattern>   Bash glob pattern matched against entry paths. Does two passes.
                Begins by attempting to use your pattern unquoted exactly as provided,
                                                     (thus affording extglob patterns)
                 second pass falls back to a case-insensitive glob ( *"<pattern,,>"* ).

OPTIONS
          -f,             Comma-separated field list
    --fields,             (default: category,updated,inspected,path)
    --format  <f1,f2,...>

EXAMPLES
    knowledge entries list
    knowledge entries list -f path,updated
    knowledge entries list 'architecture/*something'
    knowledge entries list gotchas --format path,inspected

INFO
    return 0
}

  local fields="updated,inspected,path"
  local pattern=""

  while (($# > 0)); do
    case "$1" in
    --format=*|--fields=*) fields="${1#*=}"; shift ;;
    --format|--fields|-f) fields="${2:?'-f requires a value'}"; shift 2 ;;
    -*) die "entries list: unknown option '$1'" ;;
    *)  pattern="${1,,}"; shift ;;
    esac
  done

  local entries_dir=".claude/knowledge/entries"
  [[ -d "$entries_dir" ]] || die "entries directory not found at $entries_dir"

  # Split field names into an array
  local -a field_list=()
  IFS=',' read -ra field_list <<< "$fields"

  # Validate field names
  local -a valid_fields=(path category tags files created updated inspected)
  for ((f=0;f<${#field_list[@]};f++)); do
    local match=false
    for ((v=0;v<${#valid_fields[@]};v++)); do
      [[ "${field_list[f]}" != "${valid_fields[v]}" ]] || { match=true; break; }
    done
    [[ "$match" == true ]] || die "entries list: unknown field '${field_list[f]}' (valid: ${valid_fields[*]})"
  done

  # Header row
  local hdr=""
  for ((f=0;f<${#field_list[@]};f++)); do
    ((f == 0)) || hdr+="|"
    hdr+="${field_list[f]}"
  done
  echo "$hdr"

  # Collect entry data: one line per entry, with updated field first for sorting
  local -a rows=()
  while IFS= read -r entry_file; do
    local rel_path="${entry_file#${entries_dir}/}"

    # Apply pattern filter if provided
    if [[ -n "$pattern" ]]; then
      if [[ "$rel_path" != ${pattern} ]]; then  # allows greater specificity
        [[ "$pattern" != '*'* ]] || pattern="${pattern:1}"
        [[ "$pattern" != *'*' ]] || pattern="${pattern:: -1}"
        [[ "${rel_path,,}" == *"${pattern,,}"* ]] || continue
      fi
    fi

    # Extract all frontmatter at once
    local fm
    fm=$(yq --front-matter=extract '.' "$entry_file" 2>/dev/null) || continue

    local sort_key
    sort_key=$(echo "$fm" | yq '.updated // "0000-00-00"' 2>/dev/null)

    # Build the row
    local row=""
    for ((f=0;f<${#field_list[@]};f++)); do
      ((f == 0)) || row+="|"
      case "${field_list[f]}" in
      path)      row+="$rel_path" ;;
      category)  row+=$(echo "$fm" | yq '.category // ""' 2>/dev/null) ;;
      tags)      row+=$(echo "$fm" | yq '.tags // [] | join(", ")' 2>/dev/null) ;;
      files)     row+=$(echo "$fm" | yq '.files // [] | join(", ")' 2>/dev/null) ;;
      created)   row+=$(echo "$fm" | yq '.created // ""' 2>/dev/null) ;;
      updated)   row+=$(echo "$fm" | yq '.updated // ""' 2>/dev/null) ;;
      inspected) row+=$(echo "$fm" | yq '.inspected // ""' 2>/dev/null) ;;
      esac
    done

    rows[${#rows[@]}]="${sort_key}|${row}"
  done < <(find "$entries_dir" -name '*.md' -type f 2>/dev/null)

  # Sort by the prepended sort_key (newest first), then strip it
  for ((r=0;r<${#rows[@]};r++)); do
    echo "${rows[r]}"
  done | sort -t'|' -k1,1r | cut -d'|' -f2-
}

# ── Entries dispatch ──
cmd_entries() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        entries

SYNOPSIS
        knowledge entries <TERTIARY_COMMAND> [OPTIONS]

DESCRIPTION
        Operate on knowledge entry files.

TERTIARY_COMMANDS
        list [pattern] [-f <fields>]    List entries with frontmatter metadata.

FIELDS
        path    path to the entry file
    category    (domain,architecture,gotchas,etc...)
        tags    subject-matter tags
       files    related files (subject matter)
     created    entry.created_at
     updated    entry.updated_at
   inspected    entry.inspected_at

INFO
    return 0; }
  (($# != 0)) || die "usage: knowledge entries <list> [options]"
  case "$1" in
  list) shift; cmd_entries_list "$@" ;;
  *) die "unknown entries subcommand: '${1}' (try: list)"
  esac
}


# ── show: lookup by source or entry ────────────────────────────────
# Given a path, returns the other side of the mapping.
# Source paths appear on the left of " -> ", entries appear inside brackets.
cmd_show() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        show

SYNOPSIS
        knowledge show <path>

DESCRIPTION
        Look up a source file or entry in INDEX.md and print the other side of the mapping.
        If <path> matches a source (left side), prints its entries.
        If <path> matches an entry (inside brackets), prints the source files that reference it.

ARGUMENTS
        <path>    A source file path or knowledge entry path

EXAMPLES
        'knowledge show app/models/order.rb'        # prints entries linked to sourcefile
        'knowledge show domain/order-lifecycle.md'  # prints sourcefiles linked to this entry

INFO
    return 0; }
  (($# == 1)) || die "usage: $0 show <path>"

  _require_index
  local path="$1"

  # Try as source file (left side of " -> ")
  if grep -q "^${path} -> " "$INDEX"; then
    grep "^${path} -> " "$INDEX" | sed "s/^${path//\//\\/} -> //" | tr -d '[]' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$'
    return 0
  fi

  # Try as entry (inside brackets on the right side)
  local sources
  sources="$(grep -F "$path" "$INDEX" | while IFS= read -r line; do
    local entries_part="${line#* -> }"
    # Confirm it's an exact entry match, not a substring
    if echo "$entries_part" | tr -d '[]' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -qxF "$path"; then
      echo "${line%% -> *}"
    fi
  done)"

  if [[ -n "$sources" ]]; then
    echo "$sources"
    return 0
  fi

  echo "no mapping found for: $path"
  return 1
}

# ── sort: sort INDEX.md alphabetically by source path ─────────────
cmd_sort() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        sort

SYNOPSIS
        knowledge sort

DESCRIPTION
        Sort all INDEX.md data lines alphabetically by source file path.

INFO
    return 0; }

  _require_index
  local -i A=$(wc -l < "$INDEX")
  local -i B=$(sort "$INDEX" | tee "${INDEX}.bak" | wc -l)
  if [[ -s "${INDEX}.bak" && $A == $B ]]; then
    command mv "${INDEX}.bak" "$INDEX"
  else
    echo "[ERROR] Failed to sort .claude/knowledge/INDEX.md (backup preserved at INDEX.md.bak)" >&2
    return 2
  fi
}

# ── Index: list — print index contents ────────────────────────────
# Prints INDEX.md contents. Raw by default, or as json/yaml with -f.
cmd_index_list() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
TERTIARY_COMMAND
        index list

SYNOPSIS
        knowledge index list [--format|-f json|yaml]

DESCRIPTION
        Print INDEX.md contents. Raw data lines by default.

OPTIONS
        --format, -f <fmt>    Output structured format: json or yaml
                              * Extra args after json are passed to jq.

EXAMPLES
        knowledge index list
        knowledge index list -f json
        knowledge index list --format=yaml
        knowledge index list -f json '.["app/models/order.rb"]'

INFO
    return 0; }
  _require_index

  # Parse --format / -f flag
  local format=""
  while (($# > 0)); do
    case "$1" in
    --format=*) format="${1#--format=}"; shift ;;
    --format|-f) format="${2:?'--format requires a value'}"; shift 2 ;;
    *) break ;;
    esac
  done

  if [[ -z "$format" ]]; then
    grep -v '^$' "$INDEX"
  else
    case "$format" in
    json) {
        echo '{'
        grep -v '^$' "$INDEX" | head -n-1 | sed 's|^|\"|g;s|\s[\-][\>]\s|\"\:\ |g;s|\[|\[\"|g;s|[\,]\s*|\"\,\ \"|g;s|\s*\]|\"\]\,|g'
        grep -v '^$' "$INDEX" | tail -n1 | sed 's|^|\"|g;s|\s[\-][\>]\s|\"\:\ |g;s|\[|\[\"|g;s|[\,]\s*|\"\,\ \"|g;s|\s*\]|\"\]|g'
        echo '}'
      } | jq "${@}" $JQARGS
      ;;
    yaml)
      while IFS= read -r line; do
        local src="${line%%[[:space:]]*}"
        local entries_raw="${line#*\-\>+([[:space:]])}"
        echo "${src}:"
        _parse_entries "$entries_raw" | while IFS= read -r entry; do
          echo "  - ${entry}"
        done
      done < <(grep -v '^$' "$INDEX" ) | yq "${@}" $JQARGS
      ;;
    *)
      die "index list: unknown format '$format' (expected: json, yaml, or omit)"
    esac
  fi
}

# ── Index dispatch ──
cmd_index() {
  [[ "${1,,}" != @(+(\-)h?(elp)|help) ]] || { $PRESENTER <<'INFO'
SUBCOMMAND
        index

SYNOPSIS
        knowledge index <TERTIARY_COMMAND> [OPTIONS]

DESCRIPTION
        View INDEX.md contents.

TERTIARY_COMMANDS
        list [--format|-f <fmt>]   Print index contents (raw, json, or yaml).

INFO
    return 0; }
  (($# != 0)) || die "usage: knowledge index <list> [options]"
  case "$1" in
  list) shift; cmd_index_list "$@" ;;
  *) die "unknown index subcommand: '${1}' (try: list)"
  esac
}


# ── Dispatch ──
case "$1" in
init|hooks|link|unlink|show|sort|rekey|purge|index|entries) cmd_${1} "${@:2}" ;;
--verify-settings) exec "$SOURCE_DIR/verify-settings.sh" "${@:2}" ;;
--reinstall-hooks) exec "$SOURCE_DIR/init.sh" --hooks-only "${@:2}" ;;
*) _usage 1
esac
