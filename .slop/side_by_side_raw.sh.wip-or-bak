# ── special characters as literals in patterns ──
_special_characters_as_literals_in_patterns() { cat <<'EOL'

(dopus): ── special characters  as literals  in patterns ──

({dev,,}elopers):
  Dopus was going to run like 20 iterations of what amounted to 'grep -r "$Scary S7R1NG5"'
  Most of them were testing what grep would do it you passed in
    **a properly quoted query string coincidentally containing other langs reserved words and special characters...**

    40+ times in a row, it was going to verify that **bash and grep's public apis** hadn't changed ((40+ calls): 'grep -rn "strings of characters"')
                              
  After pruning (most of) the duplicate coverage, there was really only one that was of any value
                                  (out of the 20+ that were going to run **(for both parsers)**):
                                                                that which tested the # character.
  Other than it, the rest of the following can be removed without consequence and are kept solely for entertainment purposes.

EOL
  for s in 'Class::Method' \
           'com.special.not' \
           '@decorator $variable //not-special' \
           "\# special character.  Not special: user->name"
  do
    for r in 'R' 'r'
    do  run_both "grep -${r}n \"${s}\" app/"
    done; done
}

# ── rg -F: metacharacters as literals ──
run_both 'rg -F "a+b" src/'
run_both 'rg -F "foo|bar" src/'
run_both 'rg -F "std::cout << x" src/'
run_both 'rg -F "a]b" src/'

# ── regex patterns ──
run_both 'grep -rn "^def process" app/'
run_both 'grep -rn "TODO.*FIXME" app/'
run_both 'grep -rn "user\." app/'

# ── find ──
run_both 'find . -name "*.rb"'
run_both 'find . -name "Dockerfile"'
run_both 'find src -name "*.tsx" -o -name "*.ts"'
run_both 'find . -iname "readme*"'
run_both 'find . -wholename "*/.claude/*"'
run_both 'find . -path "*/migrations/*"'
run_both 'find . -type f -name "*.log" -mtime -7'

# ── fd ──
run_both 'fd "controller"'
run_both 'fd -e py "test"'
run_both 'fd -t f "config"'
run_both 'fd --hidden "env"'
run_both 'fd -g "*.ts" src/'

# ── edge cases ──
run_both 'grep -rn "" app/'
run_both 'grep -rn "a" app/'
run_both 'rg "café" src/'
run_both 'grep -rn "日本語" src/'
run_both 'ast-grep -p "console.log($$$)" src/'

# ── flag-eating ──
run_both 'grep -rn -m 5 "pattern" app/'
run_both 'rg -A 3 -B 3 "pattern" src/'
run_both 'grep -rn -f patterns.txt app/'

# ── compound / chained ──
run_both 'grep -rn "TODO" app/ | wc -l'
run_both 'rg "error" src/ && echo "found"'
